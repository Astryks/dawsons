# Rust
/apps/desktop/src-tauri/target/
/apps/desktop/src-tauri/gen/

# Node
node_modules/
.vite/
apps/desktop/dist/

# Python
__pycache__/
*.pyc
.venv/
venv/
services/ai-sidecar/.pytest_cache/
services/ai-sidecar/.dawsons-work/
*.egg-info/

# Model weights and caches — never commit; see services/ai-sidecar/models/download_weights.py
**/models/cache/
*.pth
*.th
*.ckpt
*.onnx
*.safetensors

# Build/bundle artifacts
# dist/dawsons-sidecar/ is a special case: its README.md IS committed
# (Tauri's build script checks this path exists at compile time — see
# that README for why), but the actual frozen binary/support files
# scripts/build_sidecar.sh writes there are not.
services/ai-sidecar/dist/*
!services/ai-sidecar/dist/dawsons-sidecar
services/ai-sidecar/dist/dawsons-sidecar/*
!services/ai-sidecar/dist/dawsons-sidecar/README.md
services/ai-sidecar/build/
services/ai-sidecar/*.spec
*.dmg
*.app
*.msi
*.AppImage

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
